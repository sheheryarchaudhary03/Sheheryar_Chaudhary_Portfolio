# Optional: public URL of the site (canonical URLs, sitemap, Open Graph).
# On Vercel this defaults to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Contact form (https://resend.com). Without RESEND_API_KEY the form shows a
# friendly "email me directly" fallback instead of sending.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
